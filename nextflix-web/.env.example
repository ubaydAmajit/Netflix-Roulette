# Copy this file to .env.local and fill in ONE of the two below.
# .env.local is gitignored — credentials must never reach the client or the repo.
#
# Get either from https://www.themoviedb.org/settings/api (free account).

# Preferred: the v4 "API Read Access Token" (a long eyJ... string)
TMDB_ACCESS_TOKEN=

# Or: the v3 "API Key" (a 32-character hex string)
TMDB_API_KEY=
